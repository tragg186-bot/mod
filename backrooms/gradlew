#!/usr/bin/env sh
##############################################################################
# Gradle start up script for UN*X
#
# Generated by the Gradle wrapper. To use it, put it in your project root and
# run "./gradlew".
##############################################################################

# Determine the directory containing this script
PRG="$0"
while [ -h "$PRG" ] ; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`"/"`expr "$link" : '\(.*\)$'`
  fi
done

PRG_DIR=`dirname "$PRG"`

awK=
# Use default JVM options if not provided
if [ -z "$JAVA_HOME" ]; then
  _RUN_JAVA=java
else
  _RUN_JAVA="$JAVA_HOME/bin/java"
fi

DEFAULT_JVM_OPTS="-Xmx1g"

exec "$_RUN_JAVA" $DEFAULT_JVM_OPTS -classpath "$PRG_DIR/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
